<UserControl x:Class="WindowsDoctor.UI.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsDoctor.UI.Converters"
             xmlns:vm="clr-namespace:WindowsDoctor.UI.ViewModels"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis"/>
        <conv:StringToBrushConverter x:Key="StrToBrush"/>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
        <conv:ScoreToColorBrushConverter x:Key="ScoreBrush"/>

        <DataTemplate x:Key="FindingTemplate" DataType="{x:Type vm:FindingItemViewModel}">
            <Border Margin="0,3" Padding="12" CornerRadius="6"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Details}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding Details, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Info" Padding="8,3" Cursor="Hand" VerticalAlignment="Top"
                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{Binding SeverityColor, Converter={StaticResource StrToBrush}}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="10"
                                                      TextElement.FontWeight="SemiBold" TextElement.Foreground="#1E1E2E"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ModuleIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ModuleTitle}" Style="{StaticResource HeadingText}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubheadingText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="28" Width="56" Height="56" Margin="0,0,12,0"
                        Background="{Binding HealthScore, Converter={StaticResource ScoreBrush}}">
                    <TextBlock Text="{Binding HealthScore, StringFormat={}{0:0}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" FontWeight="Bold" Foreground="#1E1E2E"/>
                </Border>
                <Button Content="▶  Run Analysis" Style="{StaticResource ModernButton}"
                        Command="{Binding RunDiagnosticsCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}"
                        Padding="16,10"/>
            </StackPanel>
        </Grid>

        <!-- Progress -->
        <ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

        <!-- Finding count -->
        <Border Grid.Row="2" Margin="0,12,0,8" Padding="12,8" CornerRadius="6"
                Background="{StaticResource SurfaceVariantBrush}"
                Visibility="{Binding Findings.Count, Converter={StaticResource ZeroToCollapsed}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}">
                    <Run Text="{Binding Findings.Count, Mode=OneWay}"/>
                    <Run Text=" finding(s)"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0">
                    <Run Text="Last run: "/>
                    <Run Text="{Binding LastRun, StringFormat={}{0:HH:mm:ss}, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Findings -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
