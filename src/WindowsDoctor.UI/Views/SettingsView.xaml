<UserControl x:Class="WindowsDoctor.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="680">
            <TextBlock Text="⚙️  Settings" Style="{StaticResource HeadingText}" Margin="0,0,0,4"/>
            <TextBlock Text="Configure Windows Doctor preferences." Style="{StaticResource SubheadingText}" Margin="0,0,0,24"/>

            <!-- Appearance -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource MutedText}" Margin="0,0,0,12" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding DarkMode}" Margin="0,0,8,0"/>
                        <TextBlock Text="Dark mode" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Automation -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="AUTOMATION" Style="{StaticResource MutedText}" Margin="0,0,0,12" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding AutoScan}" Margin="0,0,8,0"/>
                        <TextBlock Text="Automatic scans" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Schedule:" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="80"/>
                        <ComboBox SelectedItem="{Binding AutoScanSchedule}" Width="160">
                            <ComboBoxItem>Daily</ComboBoxItem>
                            <ComboBoxItem>Weekly</ComboBoxItem>
                            <ComboBoxItem>Monthly</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DATA &amp; HISTORY" Style="{StaticResource MutedText}" Margin="0,0,0,12" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Keep history (days):" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="160"/>
                        <TextBox Text="{Binding MaxHistoryDays}" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Log level:" Style="{StaticResource BodyText}" VerticalAlignment="Center" Width="160"/>
                        <ComboBox SelectedItem="{Binding LogLevel}" Width="160">
                            <ComboBoxItem>Verbose</ComboBoxItem>
                            <ComboBoxItem>Debug</ComboBoxItem>
                            <ComboBoxItem>Information</ComboBoxItem>
                            <ComboBoxItem>Warning</ComboBoxItem>
                            <ComboBoxItem>Error</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Reports -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="REPORTS" Style="{StaticResource MutedText}" Margin="0,0,0,12" FontWeight="SemiBold"/>
                    <TextBlock Text="Output folder:" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputPath}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="📂 Open" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenOutputFolderCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="💾  Save Settings" Style="{StaticResource ModernButton}"
                        Command="{Binding SaveCommand}" Padding="20,10"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubheadingText}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
