<UserControl x:Class="WindowsDoctor.UI.Views.RepairCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsDoctor.UI.Converters"
             xmlns:vm="clr-namespace:WindowsDoctor.UI.ViewModels"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:StringToBrushConverter x:Key="StrToBrush"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="🔧  Repair Center" Style="{StaticResource HeadingText}"/>
            <TextBlock Style="{StaticResource SubheadingText}" Margin="0,4,0,0">
                <Run Text="Select and run repairs to fix detected issues."/>
                <Run Text=" ⚠️ Running as standard user — some repairs require Administrator."
                     Foreground="{StaticResource AccentYellowBrush}"/>
            </TextBlock>
        </StackPanel>

        <!-- Category filter -->
        <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Margin="0,0,6,6" Padding="12,6"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <!-- Repair list -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredRepairs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RepairItemViewModel}">
                        <Border Margin="0,0,0,8" Padding="14" CornerRadius="8"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Title + badges -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                            Background="{Binding RiskColor, Converter={StaticResource StrToBrush}}">
                                        <TextBlock Text="{Binding Definition.Risk}" FontSize="10" Foreground="#1E1E2E" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding ElevationBadge}" FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RestartBadge}"   FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Description -->
                                <TextBlock Grid.Row="1" Text="{Binding Definition.Description}"
                                           Style="{StaticResource SubheadingText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <!-- Expected impact -->
                                <TextBlock Grid.Row="2" Text="{Binding Definition.ExpectedImpact}"
                                           Foreground="{StaticResource AccentGreenBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <!-- Execute area -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,0,0,4"
                                                     Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"
                                                   Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding LastResult}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding LastResult, Converter={StaticResource NullToVis}}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Execute" Style="{StaticResource ModernButton}"
                                            Command="{Binding DataContext.ExecuteRepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsExecuting, Converter={StaticResource InvBool}}"
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Repair log -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Repair Log" Style="{StaticResource SubheadingText}" Margin="12,12,12,8"/>
                <Separator DockPanel.Dock="Top"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <TextBox Text="{Binding RepairLog, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
