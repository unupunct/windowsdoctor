<UserControl x:Class="WindowsDoctor.UI.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsDoctor.UI.Converters"
             xmlns:vm="clr-namespace:WindowsDoctor.UI.ViewModels"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis"/>
        <conv:StringToBrushConverter x:Key="StrToBrush"/>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
        <conv:ScoreToColorBrushConverter x:Key="ScoreBrush"/>

        <DataTemplate x:Key="FindingTemplate" DataType="{x:Type vm:FindingItemViewModel}">
            <Border Margin="0,3" Padding="12" CornerRadius="6"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Info" Padding="8,3" Cursor="Hand" VerticalAlignment="Top"
                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{Binding SeverityColor, Converter={StaticResource StrToBrush}}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="10"
                                                      TextElement.FontWeight="SemiBold" TextElement.Foreground="#1E1E2E"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SmartRowTemplate" DataType="{x:Type vm:SmartAttributeRowViewModel}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding IdLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Current}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="{Binding Worst}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="{Binding ThresholdLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="{Binding RawValue}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                <Border Grid.Column="6" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right"
                        Background="{Binding StatusColor, Converter={StaticResource StrToBrush}}">
                    <TextBlock Text="{Binding Status}" Foreground="#1E1E2E" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiskHealthTemplate" DataType="{x:Type vm:DiskHealthItemViewModel}">
            <Border Margin="0,6" Padding="16" CornerRadius="8"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource SurfaceVariantBrush}">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding InterfaceType}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SizeLabel}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,20,0" HorizontalAlignment="Center"
                                    Visibility="{Binding SmartAvailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DISK LIFE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding HealthLabel}" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding HealthColor, Converter={StaticResource StrToBrush}}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding HealthStatusLabel}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                                    Visibility="{Binding HasPerformance, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PERFORMANCE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PerformanceLabel}" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding PerformanceColor, Converter={StaticResource StrToBrush}}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ReadSpeedLabel}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- SMART unavailable banner -->
                    <Border Margin="0,12,0,0" Padding="10" CornerRadius="6"
                            Background="{StaticResource SurfaceVariantBrush}"
                            Visibility="{Binding SmartAvailable, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding UnavailableReason}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Detail grid -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding SmartAvailable, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TEMPERATURE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TemperatureLabel}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="POWER-ON TIME" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding PowerOnLabel}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="POWER CYCLES" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding PowerCycleLabel}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TOTAL WRITTEN" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalWrittenLabel}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding SmartAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WriteSpeedLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="  •  Reallocated sectors: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ReallocatedLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="  •  Pending sectors: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding PendingLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- SMART attribute table -->
                    <Expander Header="S.M.A.R.T. attributes" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                              Visibility="{Binding SmartAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="ATTRIBUTE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="CUR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="WORST" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="THRESH" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="RAW" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SmartRows}" ItemTemplate="{StaticResource SmartRowTemplate}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12" CornerRadius="6"
                Background="{StaticResource SurfaceVariantBrush}"
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Run as Administrator to read full S.M.A.R.T. disk health data." FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🛡️  Restart as Administrator" Style="{StaticResource GhostButton}"
                        Command="{Binding RestartAsAdminCommand}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Header row -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ModuleIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ModuleTitle}" Style="{StaticResource HeadingText}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubheadingText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="28" Width="56" Height="56" Margin="0,0,12,0"
                        Background="{Binding HealthScore, Converter={StaticResource ScoreBrush}}">
                    <TextBlock Text="{Binding HealthScore, StringFormat={}{0:0}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" FontWeight="Bold" Foreground="#1E1E2E"/>
                </Border>
                <Button Content="▶  Run Analysis" Style="{StaticResource ModernButton}"
                        Command="{Binding RunDiagnosticsCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}"
                        Padding="16,10"/>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="2" Value="{Binding Progress}" Maximum="100"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>

                <Border Margin="0,20,0,0" Padding="16" CornerRadius="8"
                        Background="{StaticResource SurfaceVariantBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Disk Life &amp; Performance" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding DiskHealthStatus}" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄  Scan Disk Health" Style="{StaticResource ModernButton}"
                                Command="{Binding ScanDiskHealthCommand}"
                                IsEnabled="{Binding IsLoadingDiskHealth, Converter={StaticResource InvBool}}"
                                Padding="14,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource DiskHealthTemplate}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
